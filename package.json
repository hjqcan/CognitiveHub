{
  "name": "@cognitive-hub/core",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable, plugin-first cognitive middleware between deliberation and execution.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jev": {
      "types": "./dist/jev.d.ts",
      "import": "./dist/jev.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:pg": "npm run build && node --env-file=.env --test tests/*.test.mjs",
    "demo": "npm run build && node examples/robot-platform.mjs",
    "replay": "node scripts/replay.mjs",
    "bench": "npm run build && node scripts/bench-step.mjs 2000 && node scripts/bench-step.mjs 1000 --pg",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "typescript": "5.8.3"
  }
}
